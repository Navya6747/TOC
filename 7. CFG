#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int len,i=0,j;

    printf("Enter string: ");
    scanf("%s",str);

    len=strlen(str);
    j=len-1;

    while(i<len && str[i]=='0')
        i++;

    while(j>=0 && str[j]=='1')
        j--;

    if(i==(len-1-j) && i+j==len-1)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
