#include <stdio.h>

int main() {
    int n,i,j;
    int e[10][10];

    printf("Enter number of states: ");
    scanf("%d",&n);

    printf("Enter epsilon transition matrix:\n");

    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&e[i][j]);

    for(i=0;i<n;i++)
    {
        printf("E-Closure(q%d) = { q%d",i,i);

        for(j=0;j<n;j++)
        {
            if(e[i][j]==1)
                printf(", q%d",j);
        }

        printf(" }\n");
    }

    return 0;
}
